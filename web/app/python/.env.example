# ─── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://qhughmeaxbyupuglpvud.supabase.co
SUPABASE_KEY=coloque-a-chave-anon-ou-service-role

# ─── Servidor ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Deixe vazio em dev. Em producao, o painel precisa mandar esse valor
# no header X-Pluvite-Token para disparar alertas manualmente.
ADMIN_TOKEN=
CORS_ORIGENS=http://localhost:3000,http://127.0.0.1:3000

# ─── OpenWeather (gatilho automatico) ───────────────────────────────────────
OPENWEATHER_KEY=coloque-sua-chave
MONITOR_ATIVO=true
MONITOR_CIDADES=Taubate,Sao Jose dos Campos
MONITOR_INTERVALO_SEGUNDOS=600
MONITOR_COOLDOWN_SEGUNDOS=10800
# Testes: le a resposta de um arquivo em vez de chamar a API de verdade
MOCK_OPENWEATHER=false
MOCK_OPENWEATHER_ARQUIVO=mocks/openweather_tempestade.json

# ─── WhatsApp ───────────────────────────────────────────────────────────────
# cloud = WhatsApp Cloud API (Meta) | evolution = Evolution API | off = desligado
WHATSAPP_PROVEDOR=cloud
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSAO=v21.0
# Preencha apenas se usar template aprovado (envio fora da janela de 24h)
WHATSAPP_TEMPLATE_NOME=
WHATSAPP_TEMPLATE_IDIOMA=pt_BR
# Alternativa self-hosted
EVOLUTION_URL=
EVOLUTION_INSTANCIA=
EVOLUTION_APIKEY=
# Numeros extras que sempre recebem (formato 5512999999999)
WHATSAPP_NUMEROS_TESTE=
WHATSAPP_DDI_PADRAO=55

# ─── Push mobile (Expo -> FCM/APNs) ─────────────────────────────────────────
PUSH_ATIVO=true
EXPO_ACCESS_TOKEN=
PUSH_CANAL_ANDROID=alertas-emergencia
# Tokens extras que sempre recebem (ExponentPushToken[...])
PUSH_TOKENS_TESTE=
