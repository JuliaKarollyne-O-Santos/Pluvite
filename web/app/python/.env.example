# ─── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://qhughmeaxbyupuglpvud.supabase.co
SUPABASE_KEY=coloque-a-chave-anon-ou-service-role

# ─── Servidor ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Token administrativo para scripts e verificacao manual do monitor; nunca exponha em NEXT_PUBLIC_.
# O painel usa sessao Supabase de servidor ou admin.
ADMIN_TOKEN=
CORS_ORIGENS=http://localhost:3000,http://127.0.0.1:3000

# ─── OpenWeather (gatilho automatico) ───────────────────────────────────────
OPENWEATHER_KEY=coloque-sua-chave
MONITOR_ATIVO=true
MONITOR_CIDADES=Aparecida,Arapeí,Areias,Bananal,Caçapava,Cachoeira Paulista,Campos do Jordão,Canas,Caraguatatuba,Cruzeiro,Cunha,Guaratinguetá,Igaratá,Ilhabela,Jacareí,Jambeiro,Lagoinha,Lavrinhas,Lorena,Monteiro Lobato,Natividade da Serra,Paraibuna,Pindamonhangaba,Piquete,Potim,Queluz,Redenção da Serra,Roseira,Santa Branca,Santo Antônio do Pinhal,São Bento do Sapucaí,São José do Barreiro,São José dos Campos,São Luiz do Paraitinga,São Sebastião,Silveiras,Taubaté,Tremembé,Ubatuba
MONITOR_INTERVALO_SEGUNDOS=3600
MONITOR_COOLDOWN_SEGUNDOS=10800
# Testes: le a resposta de um arquivo em vez de chamar a API de verdade
MOCK_OPENWEATHER=false
MOCK_OPENWEATHER_ARQUIVO=mocks/openweather_tempestade.json

# ─── WhatsApp ───────────────────────────────────────────────────────────────
# qr = chatbot local chama a API do chatbot (desenvolvimento na mesma maquina)
# qr-poll = chatbot local consulta a API hospedada e envia alertas novos por QR
# evolution = Evolution API; off = canal desligado (padrao)
WHATSAPP_PROVEDOR=off
# Na apresentação sem serviço pago, use qr-poll na API hospedada e no chatbot local.
# Defina a URL pública da API e o mesmo token secreto nos dois ambientes.
CHATBOT_PORTA=3010
CHATBOT_HOST=127.0.0.1
CHATBOT_URL=http://127.0.0.1:3010
CHATBOT_TOKEN=
PLUVITE_API_ALERTAS_URL=http://127.0.0.1:8000
# Opcional: pasta local para manter a sessão QR, inscritos e cursor entre reinícios.
PLUVITE_CHATBOT_DATA_PATH=
CHATBOT_INTERVALO_SEGUNDOS=5
EVOLUTION_URL=
EVOLUTION_INSTANCIA=
EVOLUTION_APIKEY=
# Numeros extras que sempre recebem, alem dos inscritos (formato 5512999999999)
WHATSAPP_NUMEROS_TESTE=
# Evolution: true = envia SO para os numeros de teste (no modo qr nao se aplica)
WHATSAPP_SOMENTE_TESTE=true
WHATSAPP_DDI_PADRAO=55

# ─── Push mobile (Firebase Cloud Messaging nativo) ───────────────────────────
PUSH_ATIVO=true
# Caminho do JSON de conta de servico Firebase (nao versionar esse arquivo)
FCM_SERVICE_ACCOUNT_FILE=firebase-service-account.json
# Tokens FCM extras que sempre recebem (opcional)
PUSH_TOKENS_TESTE=
